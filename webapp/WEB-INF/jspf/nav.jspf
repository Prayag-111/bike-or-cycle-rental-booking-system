<header class="topbar">
  <a class="brand-mark" href="dashboard.jsp">
    <svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
      <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="3"/>
      <path d="M16 4V28M4 16H28M8 8L24 24M8 24L24 8" stroke="currentColor" stroke-width="1"/>
      <circle cx="16" cy="16" r="3.5" fill="#f0b429"/>
    </svg>
    <span>Bike Rental</span>
  </a>

  <nav class="nav" aria-label="Main">
    <a href="dashboard.jsp"<%= "cycles".equals(activePage) ? " class=\"active\" aria-current=\"page\"" : "" %>>Cycles</a>
    <a href="bookings.jsp"<%= "bookings".equals(activePage) ? " class=\"active\" aria-current=\"page\"" : "" %>>My bookings<span class="count" id="nav-count"></span></a>
    <a href="profile.jsp"<%= "profile".equals(activePage) ? " class=\"active\" aria-current=\"page\"" : "" %>>Profile</a>
  </nav>

  <div class="topbar-right">
    <span class="live-pill" id="live-pill"><span class="dot" aria-hidden="true"></span><span id="live-text">Live</span></span>
    <form action="logout" method="post">
      <button type="submit" class="btn btn-ghost">Log out</button>
    </form>
  </div>
</header>
